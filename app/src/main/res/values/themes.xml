<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OpenRTVE" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/openrtve_accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/openrtve_background</item>
        <item name="android:statusBarColor">@color/openrtve_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="PlayerIconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_player_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="PlayerTimeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
