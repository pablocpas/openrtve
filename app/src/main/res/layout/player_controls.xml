<?xml version="1.0" encoding="utf-8"?>
<!-- Controles del reproductor: misma estructura que Findroid (arriba acciones,
     centro transporte, abajo tiempos y barra), sobre PlayerControlView de Media3,
     que enlaza por id los botones exo_* y abre sus propios selectores. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8A000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/player_back"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_player_back" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <ImageButton
            android:id="@id/exo_audio_track"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/player_audio_track"
            android:src="@drawable/ic_player_audio" />

        <ImageButton
            android:id="@id/exo_subtitle"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/player_subtitles"
            android:src="@drawable/ic_player_subtitles" />

        <ImageButton
            android:id="@id/exo_playback_speed"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/player_speed"
            android:src="@drawable/ic_player_speed" />

        <ImageButton
            android:id="@+id/player_aspect"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/player_aspect"
            android:src="@drawable/ic_player_aspect" />

        <ImageButton
            android:id="@+id/player_pip"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/player_pip"
            android:src="@drawable/ic_player_pip" />

        <ImageButton
            android:id="@+id/player_lock"
            style="@style/PlayerIconButton"
            android:contentDescription="@string/player_lock"
            android:src="@drawable/ic_player_lock" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@id/exo_rew"
            style="@style/PlayerIconButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/player_rewind"
            android:src="@drawable/ic_player_rewind" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/PlayerIconButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/player_play_pause"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@id/exo_ffwd"
            style="@style/PlayerIconButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/player_forward"
            android:src="@drawable/ic_player_forward" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Solo en directos: rojo en el borde en vivo, gris (y pulsable) si se ha quedado atrás. -->
            <TextView
                android:id="@+id/player_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_live_pill"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/player_live"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@id/exo_position"
                style="@style/PlayerTimeText" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/PlayerTimeText" />
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            app:played_color="@color/openrtve_accent"
            app:scrubber_color="@color/openrtve_accent" />
    </LinearLayout>
</FrameLayout>
