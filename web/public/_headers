# Cabeceras de Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Archivos con hash en el nombre: no cambian nunca.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# La página, el service worker y el manifiesto se revalidan siempre: así llegan las versiones nuevas.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
